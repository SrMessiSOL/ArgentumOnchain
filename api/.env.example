PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aoweb
# Dedicated operations credential. Never share this with the game or frontend.
TOKEN_AUTH=replace-with-a-unique-random-operations-secret
# Must match server TOKEN_AUTH; >=32 characters and different from TOKEN_AUTH above.
GAME_SERVICE_TOKEN=replace-with-a-different-random-game-service-secret
CORS_ORIGIN=http://localhost:3000

# Incident response: block new preparations, signatures and listings; keep reconciliation available.
AOWEB_SETTLEMENT_PAUSED=0
